# Financial Hub — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and does NOT travel with the
# repository; it is copied by hand as step 2 of the restore / machine-move
# procedure (HLD §11.3).
#
# Two profiles are documented below. They differ in exactly the ways that matter,
# and the two numbers that must never be confused are stated in full:
#
#     DEVELOPMENT   Django on port 8001, database on localhost:5433
#     PRODUCTION    Gunicorn on container port 8000, database at data-center:5432
#
# Port 8000 on the host is published by `control-tower` (Portainer) and is
# unavailable to this project. Development binds 8001 (BUILD_PLAN E11, §2.3).
#
# ---------------------------------------------------------------------------
# P-04 — THE SHARPEST EDGE IN THIS TOPOLOGY. READ BEFORE EDITING THE DB BLOCK.
# ---------------------------------------------------------------------------
# `data-center` (production) publishes 0.0.0.0:5432 on this host. `data-center-test`
# (development) publishes 0.0.0.0:5433. They differ by one digit, and the
# development server runs on the same host with DEBUG on and migrations pending.
#
#     POSTGRES_PORT=5433  →  financial_hub_dev   — development data
#     POSTGRES_PORT=5432  →  financial_hub       — a decade of real financial data
#
# `config.settings.dev` refuses to start if it finds itself pointed at the
# production database name or the production port. That guard is the tripwire;
# it is not a licence to be careless here.

# ===========================================================================
# DEVELOPMENT PROFILE  —  local hot-reloading process on Windows
# ===========================================================================

DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8001

# Django admin is a break-glass tool for recovering soft-deleted rows (ADR-03),
# not an alternative interface. It lives at a non-obvious path (§10.3).
# Change this value; do not ship the example.
DJANGO_ADMIN_PATH=ops-7f3a91

# Asia/Kuala_Lumpur — Perth and KL are both UTC+8 with no daylight saving, so the
# two locations are functionally identical year-round (HLD §9.4, OI-08).
DJANGO_TIME_ZONE=Asia/Kuala_Lumpur

# --- Database: data-center-test, the DEVELOPMENT instance -------------------
POSTGRES_DB=financial_hub_dev
POSTGRES_USER=financial_hub
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# The Django development server. 8001, not 8000 — see the note above.
DJANGO_DEV_PORT=8001

# The Vite dev server proxies /api to the Django port so the browser sees one
# origin. That is what keeps the session cookie behaving in development exactly
# as it behaves in production, with no CORS layer (BUILD_PLAN §2.3).
VITE_DEV_PORT=5173

# Development takes no dumps. The value is still read by the backup-status
# service and the smoke test, both of which report "no backups configured".
BACKUP_DIR=

# ===========================================================================
# PRODUCTION PROFILE  —  the `financial-hub` container on the vibe-city network
# ===========================================================================
# Uncomment this block and comment out the development one above. Everything
# below is what changes.
#
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=financial-hub.localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=http://financial-hub.localhost
#
# --- Database: data-center, the PRODUCTION instance -------------------------
# Reached by Docker DNS over the `vibe-city` network. `data-center` must be
# attached to that network once, with:
#     docker network connect vibe-city data-center
# The hostname `data-center` does not resolve from the Windows host at all,
# which is what makes TR-07 structural rather than a matter of discipline.
#
# POSTGRES_DB=financial_hub
# POSTGRES_USER=financial_hub
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=data-center
# POSTGRES_PORT=5432
#
# --- Backups (ADR-11, OI-12) ------------------------------------------------
# The Windows folder the container writes dumps into, bind-mounted at /backups.
# The database is shared with other tenants, so this dump is the only thing
# standing between another project's `docker compose down -v` and the loss of a
# decade of typing (BUILD_PLAN P-02). It is not optional.
#
# Nominated 15 Aug 2026: D:/Backups/Financial Hub.
#
# OI-12 remains **partly open** at that path, and deliberately so. The folder is
# on a local disk, so it survives losing the Docker VM, a bad migration, or
# another tenant's teardown — which is what P-02 is about, and the likeliest
# way this data dies. It does not survive losing the machine. Closing OI-12
# fully means a replicated destination; syncing this folder later is a one-line
# change and no data has to move.
#
# BACKUP_HOST_DIR=D:/Backups/Financial Hub
# BACKUP_DIR=/backups
# BACKUP_RETAIN=30
#
# The smoke test fails if the newest dump is older than this many hours.
# BACKUP_MAX_AGE_HOURS=24
#
# --- Gunicorn ---------------------------------------------------------------
# Two workers. One user, nothing asynchronous (ADR-10).
# GUNICORN_WORKERS=2
# GUNICORN_BIND=0.0.0.0:8000
