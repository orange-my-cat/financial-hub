# Secrets and data — never committed. .env.example is the committed template.
.env
.env.*
!.env.example

# Database dumps. These are the backup mechanism (ADR-11); they live in the
# nominated Windows folder, never in the repository.
*.dump
*.sql.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Django collected static — rebuilt by the image, never committed
backend/staticfiles/

# The built React bundle. The image's Node stage puts it here; it can also be
# copied here by hand to have the Django dev server serve the application
# without Vite. Build output either way, and never committed.
backend/frontend_dist/

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Browser-check screenshots — regenerated on every run
scripts/screenshots/
