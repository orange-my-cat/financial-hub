# The repository lives on Windows; the container runs Linux. Anything the
# container executes or parses must keep LF endings regardless of core.autocrlf,
# or the entrypoint fails with an unhelpful "bad interpreter" at start.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.dump binary
